# انسخ هذا الملف باسم .env وضع القيم الحقيقية من مشروعك في Supabase.
# لا تضع أي قيم حقيقية داخل هذا الملف (.env.example) نفسه — إنه للتوثيق فقط.
# ملف .env الحقيقي لا يجب رفعه أبدًا إلى Git (تم استثناؤه في .gitignore).

# رابط مشروعك في Supabase
# تجده في: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# مفتاح anon / publishable الخاص بالمشروع (آمن للاستخدام في الواجهة الأمامية)
# تجده في نفس الصفحة: Supabase Dashboard -> Project Settings -> API -> anon public key
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# عنوان الموقع المنشور (بدون / في النهاية). يُستخدم لروابط المسابقات ولصورة معاينة الرابط.
# اتركيه فارغًا أثناء التطوير المحلي. مثال: https://bunyan.example.com
VITE_PUBLIC_SITE_URL=
